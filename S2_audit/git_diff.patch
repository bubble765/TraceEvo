diff --git a/configs/TraceEvo_Configs.yaml b/configs/TraceEvo_Configs.yaml
index c1a6d85..7e7f58c 100644
--- a/configs/TraceEvo_Configs.yaml
+++ b/configs/TraceEvo_Configs.yaml
@@ -21,6 +21,16 @@ traceevo:
     recording_path: ""
     strict: true
 
+  # S2 §1 D1: identity of the backbone that produced the events.
+  # `model_id` is what the config names -- reliable, but it is a *name*, not a
+  # build. `model_version` stays null unless the provider reports one, and
+  # `version_observable` says which of the two a reader is looking at, so no
+  # downstream claim can overstate it. Empty model_id -> the GoS backbone from
+  # configs/LLM_Configs.yaml (default_model_path).
+  model_id: ""
+  model_version: null
+  version_observable: false
+
   # Deterministic source classification (amendment §1 D2). No LLM judgement.
   source_classification:
     verbatim: true
