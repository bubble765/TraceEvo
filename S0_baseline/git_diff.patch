new file mode 100644
index 0000000..ba0e82a
--- /dev/null
+++ b/build_s0_results.py
@@ -0,0 +1,110 @@
+"""TraceEvo S0: merge predictions, judge scores and per-case LLM accounting
+into the final S0_baseline/results.csv."""
+import argparse
+import json
+import re
+
+import pandas as pd
+
+CASE_RE = re.compile(r"\[RUN\] Case (\d+)")
+CALL_RE = re.compile(r"Input token nums：(\d+) \| Output token nums：(\d+)")
+RETRY_RE = re.compile(r"\[LLM-API\] attempt (\d)/")
+
+
+def parse_run_log(path):
+    """Per-case LLM call / token / retry accounting, keyed by case index."""
+    stats = {}
+    current = None
+    with open(path, encoding="utf-8", errors="replace") as f:
+        for line in f:
+            m = CASE_RE.search(line)
+            if m:
+                current = int(m.group(1))
+                stats.setdefault(current, {"llm_calls": 0, "prompt_tokens": 0,
+                                           "completion_tokens": 0, "retries": 0})
+                continue
+            if current is None:
+                continue
+            if RETRY_RE.search(line):
+                stats[current]["retries"] += 1
+                continue
+            # Skip the cumulative "[LLM-API] Total |" summary line: it has the
+            # same field names but reports process-wide totals.
+            if "Generation Completed" not in line:
+                continue
+            m = CALL_RE.search(line)
+            if m:
+                stats[current]["llm_calls"] += 1
+                stats[current]["prompt_tokens"] += int(m.group(1))
+                stats[current]["completion_tokens"] += int(m.group(2))
+    return stats
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--results", required=True)
+    ap.add_argument("--run-log", required=True)
+    ap.add_argument("--judge-scores", required=True)
+    ap.add_argument("--summary-glob", required=True,
+                    help="raw_outputs dir holding case<N>_summary.json")
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args()
+
+    df = pd.read_csv(args.results, encoding="utf-8")
+    df = df.reset_index().rename(columns={"index": "case_index"})
+    log_stats = parse_run_log(args.run_log)
+
+    judge = pd.read_csv(args.judge_scores, encoding="utf-8")
+    judge = judge[["case_index", "judge_score"]]
+    df = df.merge(judge, on="case_index", how="left")
+
+    import glob
+    import os
+    graph_stats = {}
+    for p in glob.glob(os.path.join(args.summary_glob, "case*_summary.json")):
+        with open(p, encoding="utf-8") as f:
+            s = json.load(f)
+        graph_stats[s["case_index"]] = s
+
+    rows = []
+    for _, r in df.iterrows():
+        idx = int(r["case_index"])
+        ls = log_stats.get(idx, {})
+        gs = graph_stats.get(idx, {})
+        rows.append({
+            "case_index": idx,
+            "prediction": r["prediction"],
+            "answer": r["answer"],
+            "judge_score": r["judge_score"],
+            "llm_calls": ls.get("llm_calls"),
+            "prompt_tokens": ls.get("prompt_tokens"),
+            "completion_tokens": ls.get("completion_tokens"),
+            "retries": ls.get("retries"),
+            "graph_snapshots": gs.get("n_graph_snapshots"),
+            "final_graph_nodes": gs.get("final_graph_nodes"),
+            "final_graph_edges": gs.get("final_graph_edges"),
+            "backtrackings": gs.get("n_backtrackings"),
+            "levels_deleted": gs.get("n_levels_deleted"),
+            "report_chars": len(str(r["report"])) if pd.notna(r["report"]) else None,
+        })
+
+    out = pd.DataFrame(rows)
+    out.to_csv(args.out, index=False, encoding="utf-8")
+    print(out.to_string(max_colwidth=48))
+    print(f"\n-> {args.out}")
+
+    scored = out.dropna(subset=["judge_score"])
+    n = len(scored)
+    print(f"\ncases={len(out)} scored={n} unparsed={len(out)-n}")
+    if n:
+        print(f"Match    = {(scored['judge_score']==2).sum()}/{n} = "
+              f"{(scored['judge_score']==2).mean()*100:.2f}%")
+        print(f"Relevant = {(scored['judge_score']>=1).sum()}/{n} = "
+              f"{(scored['judge_score']>=1).mean()*100:.2f}%")
+    print(f"total LLM calls = {out['llm_calls'].sum()}, "
+          f"prompt_tokens = {out['prompt_tokens'].sum()}, "
+          f"completion_tokens = {out['completion_tokens'].sum()}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/collect_s0_artifacts.py b/collect_s0_artifacts.py
new file mode 100644
index 0000000..ae1277d
--- /dev/null
+++ b/collect_s0_artifacts.py
@@ -0,0 +1,103 @@
+"""TraceEvo S0: collect per-case artifacts into the S0_baseline deliverable.
+
+Produces:
+  raw_outputs/case<N>_trace.txt        full GoS reasoning log for the case
+  raw_outputs/case<N>_graphs.json      causal-graph snapshots (from the HTML blob)
+  raw_outputs/case<N>_graph.html       interactive causal-graph snapshot
+  raw_outputs/case<N>_summary.json     per-case call/token/time accounting
+"""
+import argparse
+import json
+import os
+import re
+import shutil
+
+import pandas as pd
+
+HTML_DATA_RE = re.compile(r"const\s+graphData\s*=\s*(.*?);\s*\n", re.S)
+
+
+def extract_graphs(html_path):
+    if not os.path.exists(html_path):
+        return None
+    with open(html_path, "r", encoding="utf-8") as f:
+        html = f.read()
+    m = HTML_DATA_RE.search(html)
+    if not m:
+        return None
+    try:
+        return json.loads(m.group(1))
+    except json.JSONDecodeError:
+        return None
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--case-log-root", default="logs/S0_dev10")
+    ap.add_argument("--html-dir", default="outputs/html_s0")
+    ap.add_argument("--results", default="outputs/s0_dev10.csv")
+    ap.add_argument("--run-log", default="")
+    ap.add_argument("--out-dir", required=True)
+    args = ap.parse_args()
+
+    os.makedirs(args.out_dir, exist_ok=True)
+
+    # Map case index -> ground truth from the results CSV (row order == case order).
+    df = pd.read_csv(args.results, encoding="utf-8")
+
+    case_ids = sorted(
+        int(d.split("_")[1]) for d in os.listdir(args.case_log_root)
+        if d.startswith("Case_")
+    )
+    print(f"collecting {len(case_ids)} cases: {case_ids}")
+
+    for idx in case_ids:
+        case_dir = os.path.join(args.case_log_root, f"Case_{idx}")
+        # Multiple timestamped logs can exist if a case was retried; take the newest.
+        logs = sorted(f for f in os.listdir(case_dir) if f.endswith(".txt"))
+        if not logs:
+            print(f"  case {idx}: no trace log, skipped")
+            continue
+        src_log = os.path.join(case_dir, logs[-1])
+        shutil.copyfile(src_log, os.path.join(args.out_dir, f"case{idx}_trace.txt"))
+
+        html_src = os.path.join(args.html_dir, f"case{idx}.html")
+        graphs = extract_graphs(html_src)
+        if graphs is not None:
+            with open(os.path.join(args.out_dir, f"case{idx}_graphs.json"),
+                      "w", encoding="utf-8") as f:
+                json.dump(graphs, f, ensure_ascii=False, indent=2)
+            if os.path.exists(html_src):
+                shutil.copyfile(html_src, os.path.join(args.out_dir, f"case{idx}_graph.html"))
+
+        trace = open(src_log, encoding="utf-8", errors="replace").read()
+        summary = {
+            "case_index": idx,
+            "trace_log": logs[-1],
+            "trace_bytes": os.path.getsize(src_log),
+            "n_graph_snapshots": len(graphs) if graphs else 0,
+            "final_graph_nodes": len(graphs[-1]["nodes"]) if graphs else None,
+            "final_graph_edges": len(graphs[-1]["edges"]) if graphs else None,
+            "n_llm_calls_in_trace": trace.count("#### Step"),
+            "n_backtrackings": trace.count("backtracking invoked"),
+            "n_levels_deleted": trace.count("deteled"),
+            "n_retrieval_observations": trace.count("Observations:"),
+            "n_tool_observations": trace.count("Tool observations:"),
+        }
+        if idx < len(df):
+            summary["prediction"] = df.iloc[idx]["prediction"]
+            summary["answer"] = df.iloc[idx]["answer"]
+        with open(os.path.join(args.out_dir, f"case{idx}_summary.json"),
+                  "w", encoding="utf-8") as f:
+            json.dump(summary, f, ensure_ascii=False, indent=2)
+        print(f"  case {idx}: {summary['n_graph_snapshots']} graph snapshots, "
+              f"{summary['final_graph_nodes']} nodes / {summary['final_graph_edges']} edges, "
+              f"{summary['n_backtrackings']} backtracks")
+
+    if args.run_log and os.path.exists(args.run_log):
+        shutil.copyfile(args.run_log, os.path.join(args.out_dir, "..", "run.log"))
+    print(f"artifacts -> {args.out_dir}")
+
+
+if __name__ == "__main__":
+    main()
