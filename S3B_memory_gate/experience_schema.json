{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "traceevo/s3b/experience_schema.json",
  "title": "TraceEvo S3B Experience Candidate (§5)",
  "description": "One experience candidate. The split that matters is retrieval_metadata (compared, never shown) versus payload (the only part that reaches a planner prompt). §5.2's forbidden contents are enforced by Experience.forbidden_content() and re-checked by experience_gate.evaluate, which REJECTs rather than annotates.",
  "type": "object",
  "properties": {
    "memory_id": {
      "type": "string"
    },
    "source_trace_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "task_retrieval_key": {
      "type": "string"
    },
    "outcome_verdict": {
      "type": "string"
    },
    "audit_summary_hash": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "eligibility": {
      "type": "string"
    },
    "gate_reasons": {
      "type": "array"
    },
    "evidence_profile": {
      "type": "object"
    },
    "uncommitted_calls": {
      "type": "integer",
      "default": 0
    },
    "extractor_version": {
      "type": "string",
      "default": "s3b-deterministic-v1"
    },
    "created_at": {
      "type": "string"
    },
    "source_trace_hashes": {
      "type": "object"
    }
  },
  "required": [
    "audit_summary_hash",
    "memory_id",
    "outcome_verdict",
    "source_trace_id",
    "task_id",
    "task_retrieval_key"
  ],
  "x-extractor_version": "s3b-deterministic-v1",
  "x-eligibility_outcomes": {
    "eligible": "Validated Success: retrievable, injectable",
    "failure_experience": "Validated Failure (§6.2): retrievable, injectable",
    "manual_review": "stored for a human, NEVER retrievable (§6.3)",
    "reject": "not stored"
  },
  "x-retrievable_partitions": [
    "failure",
    "success"
  ],
  "x-ledger_stages": [
    "CENTRAL_PLAN",
    "EXPERT_DECISION",
    "EXPERT_CONTENT",
    "GRAPH_UPDATE",
    "REPORT",
    "EVIDENCE_RETRIEVAL",
    "OTHER"
  ],
  "x-parse_statuses": [
    "pending",
    "accepted",
    "discarded",
    "failed"
  ],
  "x-discard_reasons": [
    "NONE",
    "DECISION_CONTENT_MISMATCH",
    "PARSER_ERROR",
    "INVALID_SCHEMA",
    "OTHER"
  ],
  "x-forbidden_in_payload": [
    "reference diagnosis (Final Diagnosis)",
    "Right Option",
    "historical prediction",
    "patient identity / verbatim case text",
    "uncommitted model output",
    "P2 content presented as external fact"
  ]
}